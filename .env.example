# Copy to .env and adjust. Docker Compose reads this file automatically.

# Warehouse (PostgreSQL). Docker Compose reads these three for the warehouse service.
WAREHOUSE_USER=pulseiq
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_DB=pulseiq
# Only for running the ETL on your PC outside Docker (Compose sets its own value inside the etl container).
# Leave empty to skip the warehouse load. Port 5433 is the one Compose publishes.
WAREHOUSE_DSN=

# Folder layout (inside Docker these are overridden by docker-compose.yml)
RAW_DIR=data/raw
CLEAN_DIR=data/clean
REJECTED_DIR=data/rejected
LOG_DIR=logs

# parquet or csv
OUTPUT_FORMAT=parquet

# Reference date for tenure and "is_active". Leave empty to use the latest
# attendance date in the data. Set it explicitly if you want a fixed cut-off.
AS_OF_DATE=

# Abort the run if more than this share of any table's rows is rejected.
MAX_REJECT_PCT=10

# Set true if raw dates like 03/04/2024 mean 3 April. The workbook uses 2025-04-30.
DATES_DAYFIRST=false

# When true, the run fails if payroll totals do not match the workbook's
# reconciliation_answer_key sheet. When false it logs a warning and records FAIL.
RECONCILE_STRICT=false

# Apache Superset (Task 3)
# Secret key for session encryption (generate a secure random 32+ character string in production)
SUPERSET_SECRET_KEY=pulseiq-superset-secret-key-32-chars-minimum-prod
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# Read-only database user for Superset (restricted to SELECT on schema dw)
SUPERSET_RO_USER=superset_ro
SUPERSET_RO_PASSWORD=superset_ro_pass

